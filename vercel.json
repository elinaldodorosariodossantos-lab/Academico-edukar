{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/alunos", "destination": "/index.html" },
    { "source": "/alunos/(.*)", "destination": "/index.html" },
    { "source": "/turmas", "destination": "/index.html" },
    { "source": "/horarios", "destination": "/index.html" },
    { "source": "/frequencia", "destination": "/index.html" },
    { "source": "/relatorios", "destination": "/index.html" },
    { "source": "/financeiro", "destination": "/index.html" }
  ]
}
