{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/alunos",
      "destination": "/index.html"
    },
    {
      "source": "/alunos/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/turmas",
      "destination": "/index.html"
    },
    {
      "source": "/horarios",
      "destination": "/index.html"
    },
    {
      "source": "/frequencia",
      "destination": "/index.html"
    },
    {
      "source": "/relatorios",
      "destination": "/index.html"
    },
    {
      "source": "/financeiro",
      "destination": "/index.html"
    }
  ]
}
